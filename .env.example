# =============================================================================
# Social Hotspot Daily — Environment Variables Template
# 复制为 .env 并填入你的值
# cp .env.example .env
# =============================================================================

# =============================================================================
# LLM Provider (DeepSeek)
# =============================================================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# =============================================================================
# Data Sources
# =============================================================================
# Twitter/X API (Free tier: basic access with monthly limits)
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# Reddit API (Create at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# YouTube Data API v3 (Enable at Google Cloud Console)
YOUTUBE_API_KEY=your-youtube-api-key

# =============================================================================
# Output — Telegram
# =============================================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# =============================================================================
# Output — Blog / Domain
# =============================================================================
BLOG_BASE_URL=https://yourdomain.com
BLOG_TITLE=Tech Hotspot Daily
BLOG_DESCRIPTION=每日全球科技热点聚合
BLOG_AUTHOR=Social Hotspot Bot

# =============================================================================
# Newsletter (Resend)
# =============================================================================
RESEND_API_KEY=re_your-resend-api-key
NEWSLETTER_FROM_EMAIL=newsletter@yourdomain.com

# =============================================================================
# Analytics & Ads (Google)
# =============================================================================
# GA4 Measurement ID — create at https://analytics.google.com
GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google AdSense Publisher ID — create at https://adsense.google.com
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# =============================================================================
# Cloudflare Worker
# =============================================================================
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_DATABASE_ID=your-d1-database-id
CLOUDFLARE_ROUTE=hotspot.edgesoft.org/api/*
