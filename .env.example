# Vercel Environment Variables (set in Vercel Dashboard)

# Turso Database
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Resend Email
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=newsletter@yourdomain.com
BLOG_BASE_URL=https://hotspot.edgesoft.org

# Turnstile Bot Detection
TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxx

# Subscriber API Key (for GitHub Actions)
SUBSCRIBERS_API_KEY=your-generated-api-key
